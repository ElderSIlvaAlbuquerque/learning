{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "baseUrl": "../../",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@nextread/core": ["packages/core/src/index.ts"],
      "@nextread/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../core" },
    { "path": "../shared" }
  ]
}
